---
// NAME: Layout
// PATH: /src/layouts/layout.astro

import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Astro.js Template",
	description = "An Astro.js web application template.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<meta name="description" content={description}>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
